# Copy this file to .env.local for local development.
# The values below match docker-compose.yml, so they work as-is.

# Pooled connection used by the app.
# On Vercel, the Neon integration sets this automatically.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5434/portfolio

# Direct (non-pooled) connection used by drizzle-kit for migrations.
# On Vercel, the Neon integration sets this automatically.
DATABASE_URL_UNPOOLED=postgres://portfolio:portfolio@localhost:5434/portfolio

# Public URL of the site, used for metadata and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
