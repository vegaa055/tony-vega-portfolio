# Copy this file to .env.local for local development.
# The database values below match docker-compose.yml, so they work as-is.

# Pooled connection used by the app.
# On Vercel, the Neon integration sets this automatically.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5434/portfolio

# Direct (non-pooled) connection used by drizzle-kit for migrations.
# On Vercel, the Neon integration sets this automatically.
DATABASE_URL_UNPOOLED=postgres://portfolio:portfolio@localhost:5434/portfolio

# Public URL of the site, used for metadata, absolute links, and the admin
# login's origin checks. On Vercel, set this for Production only: preview
# deployments then use their own address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs admin sessions. At least 32 characters; use a different value in every
# environment and never commit a real one. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me-with-a-random-secret-of-32-or-more-characters

# Image uploads. Leave these unset locally: development uploads are saved to
# .uploads (git-ignored) and served from /uploads. On Vercel, connecting a
# Blob store sets BLOB_STORE_ID and BLOB_WEBHOOK_PUBLIC_KEY, and uploads sign
# in with Vercel's rotating OIDC credentials. An older read-write token
# (BLOB_READ_WRITE_TOKEN) also works, but isn't needed.
# BLOB_STORE_ID=
# BLOB_WEBHOOK_PUBLIC_KEY=
